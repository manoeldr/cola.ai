@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using ColaAI.Web.Models
@using ColaAI.Web.Services
@using System.Text.Json
@inject CorpusReader Reader
@inject GeminiSummaryService Gemini
@inject LocalLibrary Library
@inject StudyService Study

<PageTitle>Cola.ai · Resumo da disciplina</PageTitle>
<main>
    <header><span class="brand">Cola.ai</span><span class="badge">FASE 2 · C# / .NET</span></header>
    <h1>Seu acervo.<br />Uma revisão completa.</h1>
    <p class="lead">Importe os materiais coletados pela extensão e gere um resumo que considere todo o texto disponível.</p>
    <section class="card">
        <h2>1. Importe a disciplina</h2>
        <p>Selecione <strong>cola-ai-acervo-disciplina.json</strong>, exportado pela importação em lote.</p>
        <InputFile OnChange="Import" accept=".json,application/json" disabled="@busy" />
        <p class="muted">O acervo e o índice ficam salvos neste computador, em SQLite. Não é necessário importar novamente a cada visita.</p>
    </section>
    @if (courses.Count > 0)
    {
        <section class="card"><h2>Disciplinas salvas</h2>
            @foreach (var course in courses) { <p><button class="secondary" disabled="@busy" @onclick="() => LoadCourse(course.Key)">@course.Title</button></p> }
        </section>
    }
    @if (!string.IsNullOrEmpty(error)) { <p class="error" role="alert">@error</p> }
    @if (corpus is not null)
    {
        <section class="card">
            <h2>@corpus.Title</h2>
            <div class="stats"><span><strong>@corpus.Documents.Count</strong> materiais</span><span><strong>@corpus.PageCount</strong> páginas</span><span><strong>@corpus.CharacterCount.ToString("N0")</strong> caracteres</span></div>
            <p><a class="download" href="@($"/foto?course={LocalLibrary.CourseKey(corpus)}")">Resolver questões por foto</a></p>
            <details><summary>Materiais e cobertura</summary>
                <ul>@foreach (var d in corpus.Documents) { <li>@d.Id · @d.Name · @d.Pages.Count páginas</li> }</ul>
                @foreach (var warning in corpus.Warnings) { <p class="muted">@warning</p> }
            </details>
        </section>
        <section class="card">
            <h2>2. Gere o resumo geral</h2>
            <p>@cachedDocuments de @corpus.Documents.Count resumos de materiais já salvos para este modelo.</p>
            <p>Na primeira geração, cada material é resumido por inteiro. Os resumos são salvos e depois consolidados. Nas próximas gerações, só os materiais novos ou alterados precisam ser resumidos. Modelo: <strong>@Gemini.Model</strong>.</p>
            @if (!Gemini.Configured) { <p class="notice">A integração está pronta, mas falta configurar a chave local e confirmar um projeto sem faturamento. Consulte o README. Não cole sua chave no chat.</p> }
            <button disabled="@busy" @onclick="Generate">@(busy ? "Gerando resumo…" : "Gerar resumo geral")</button>
            @if (busy) { <button class="secondary" @onclick="Cancel">Cancelar</button><p role="status">@progress</p> }
            <p class="muted">Se a cota interromper o processo, os resumos concluídos continuam salvos. Ao clicar novamente, a aplicação retoma do que falta. Sem troca automática de modelo. As cotas dependem do projeto Google; a aplicação não consegue verificar seu faturamento.</p>
        </section>
    }
    @if (corpus is not null)
    {
        <section class="card"><h2>3. Pesquise no acervo</h2>
            <p>A busca local não usa tokens. Para uma resposta da IA, apenas os trechos encontrados serão enviados.</p>
            <input class="query" aria-label="Pesquisar ou perguntar" @bind="question" @bind:event="oninput" maxlength="2000" disabled="@busy" placeholder="Ex.: redes neurais e overfitting" />
            <button disabled="@busy" @onclick="Search">Buscar trechos</button>
            <button class="secondary" disabled="@(busy || !Gemini.Configured)" @onclick="Ask">Perguntar à IA</button>
            @if (searchPerformed) { <p class="muted">Pesquisa: <strong>@lastQuery</strong> · @hits.Count trecho(s) encontrado(s).</p> }
            @foreach (var hit in hits)
            { <details class="source"><summary>@hit.Name · página @hit.Page</summary><pre>@hit.Text</pre></details> }
            @if (searchPerformed && hits.Count == 0) { <p>Nenhum trecho encontrado. Tente palavras usadas no material.</p> }
            @if (answer is not null)
            { <article><h3>@answer.Summary.Title</h3>
                @foreach (var topic in answer.Summary.Sections)
                { <p class="prose">@topic.Text</p>
                    @foreach (var citation in topic.References)
                    { var doc = corpus.Documents.Single(d => d.Id == citation.DocumentId);
                        <details class="source"><summary>@doc.Name · página @citation.Page</summary><pre>@doc.Pages.Single(p => p.Page == citation.Page).Text</pre></details>
                    }
                }
            </article> }
        </section>
    }
    @if (result is not null)
    {
        <section class="card result">
            <span class="badge">RESUMO GERADO</span><h2>@result.Summary.Title</h2>
            @if (result.SupplementedDocuments > 0)
            { <p class="notice">A síntese temática foi complementada com os resumos individuais de @result.SupplementedDocuments material(is) que não receberam referência na consolidação. Os complementos estão identificados abaixo, com seus textos e fontes originais.</p> }
            <p>@result.DocumentCount materiais contemplados · @result.PageCount páginas · referências verificadas estruturalmente.</p>
            <p class="muted">Esta revisão consolida resumos por material e pode perder detalhes. A existência das fontes foi validada; isso não garante que toda afirmação esteja correta ou que cada página tenha sido abordada. Confira os trechos abaixo.</p>
            <a class="download" href="@ExportUrl" download="cola-ai-resumo.json">Salvar resumo e referências</a>
            @foreach (var topic in result.Summary.Sections)
            {
                <article><h3>@topic.Title</h3><p class="prose">@topic.Text</p>
                @foreach (var citation in topic.References)
                {
                    var doc = corpus!.Documents.Single(d => d.Id == citation.DocumentId);
                    <details class="source"><summary>@doc.Name · página @citation.Page</summary><pre>@doc.Pages.Single(p => p.Page == citation.Page).Text</pre></details>
                }
                </article>
            }
        </section>
    }
    <footer>Manoel Rodrigues e Uilsom Cardoso · Projeto acadêmico de uso próprio</footer>
</main>

@code {
    private IReadOnlyList<SavedCourse> courses = [];
    private IReadOnlyList<SearchHit> hits = [];
    private SummaryResult? answer;
    private string question = "";
    private string lastQuery = "";
    private string progress = "";
    private bool searchPerformed;
    private int cachedDocuments;
    protected override void OnInitialized() { courses = Library.List(); }
    private void LoadCourse(string key)
    {
        if(busy)return;
        corpus = Library.Load(key); result = corpus is null ? null : Study.SavedSummary(corpus);
        cachedDocuments = corpus is null ? 0 : Study.CachedDocuments(corpus);
        answer = null; hits = []; question = ""; searchPerformed = false; error = null;
    }
    private void Search()
    {
        if(corpus is null)return;
        error=null;answer=null;lastQuery=question.Trim();
        if(string.IsNullOrWhiteSpace(lastQuery)){error="Digite um termo ou uma pergunta antes de pesquisar.";hits=[];searchPerformed=false;return;}
        hits = Library.Search(corpus, lastQuery); searchPerformed = true;
    }
    private async Task Ask()
    {
        if(corpus is null || busy)return;
        error=null; answer=null;busy=true;cancellation?.Dispose();cancellation=new CancellationTokenSource();
        try { lastQuery=question.Trim(); hits=Library.Search(corpus,lastQuery);searchPerformed=true;answer=await Study.AskAsync(corpus,lastQuery,cancellation.Token); }
        catch(OperationCanceledException){error="Resposta cancelada ou tempo limite excedido.";}
        catch(HttpRequestException){error="Falha de conexão com o Gemini. Nenhuma nova tentativa foi feita.";}
        catch(Exception ex) when(ex is InvalidDataException or InvalidOperationException or JsonException){error=ex.Message;}
        finally{busy=false;}
    }
    private Corpus? corpus;
    private SummaryResult? result;
    private string? error;
    private bool busy;
    private CancellationTokenSource? cancellation;
    private string ExportUrl => "data:application/json;charset=utf-8;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(
        JsonSerializer.Serialize(new { result, documents = corpus!.Documents.Select(d => new { d.Id, d.Name }), coverage = corpus.Coverage }, CorpusReader.JsonOptions)));
    private async Task Import(InputFileChangeEventArgs e)
    {
        error = null; result = null; corpus = null; busy = true;
        try { await using var stream = e.File.OpenReadStream(CorpusReader.MaxUploadBytes); corpus = LocalLibrary.Stable(await Reader.ReadAsync(stream)); Library.Save(corpus); courses=Library.List(); cachedDocuments=Study.CachedDocuments(corpus); result=Study.SavedSummary(corpus); hits=[];answer=null;searchPerformed=false; }
        catch (Exception ex) when (ex is InvalidDataException or IOException or JsonException) { error = ex.Message; }
        finally { busy = false; }
    }
    private async Task Generate()
    {
        if (corpus is null || busy) return;
        error = null; result = null; busy = true;
        cancellation?.Dispose(); cancellation = new CancellationTokenSource();
        try { result = await Study.SummarizeAsync(corpus, message => { progress=message; _ = InvokeAsync(StateHasChanged); }, cancellation.Token); }
        catch (OperationCanceledException) { error = cancellation.IsCancellationRequested ? "Geração cancelada." : "O tempo de resposta foi excedido. Nenhuma nova tentativa foi feita."; }
        catch (HttpRequestException) { error = "Não foi possível conectar ao Gemini. Confira a conexão. Nenhuma nova tentativa foi feita."; }
        catch (Exception ex) when (ex is InvalidOperationException or InvalidDataException or JsonException) { error = ex.Message; }
        finally { busy = false; cachedDocuments=Study.CachedDocuments(corpus); }
    }
    private void Cancel() => cancellation?.Cancel();
    public void Dispose() { cancellation?.Cancel(); cancellation?.Dispose(); }
}
